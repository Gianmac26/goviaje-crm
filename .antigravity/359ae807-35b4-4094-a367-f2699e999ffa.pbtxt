        lines {
          text: "                  else if (agent.status === AgentStatus.ALMUERZO) statusBg = \'bg-amber-500\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  else if (agent.status === AgentStatus.PAUSA) statusBg = \'bg-sky-500\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
