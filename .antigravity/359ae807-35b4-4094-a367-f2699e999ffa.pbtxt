        lines {
          text: "          const speedFactor = parseFloat(playbackSpeed);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          return Math.min(playingRec.duration, prev + speedFactor);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
