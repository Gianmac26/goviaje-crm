    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  LineChart, \n  Eye, \n  UserCircle, \n  Rocket, \n  GitBranch, \n  Globe, \n  Mail, \n  Grid, \n  Radio, \n  Calendar, \n  Settings \n} from \'lucide-react\';\n\ninterface SidebarProps {\n  activeSection: string;\n  setActiveSection: (section: string) => void;\n}\n\nexport default function Sidebar({ activeSection, setActiveSection }: SidebarProps) {\n  const menuItems = [\n    { id: \'dashboard\', icon: LineChart, label: \'M\303\251tricas\' },\n    { id: \'monitoring\', icon: Eye, label: \'Monitoreo\' },\n    { id: \'users\', icon: UserCircle, label: \'Usuarios\' },\n    { id: \'rocket\', icon: Rocket, label: \'Campa\303\261as\' },\n    { id: \'workflow\', icon: GitBranch, label: \'Flujos\' },\n    { id: \'planet\', icon: Globe, label: \'P\303\241ginas\' },\n    { id: \'messages\', icon: Mail, label: \'Mensajes\' },\n    { id: \'grid\', icon: Grid, label: \'M\303\263dulos\' },\n    { id: \'radio\', icon: Radio, label: \'Canales\' },\n    { id: \'calendar\', icon: Calendar, label: \'Calendario\' },\n  ];\n\n  return (\n    <aside id=\"sidebar\" className=\"fixed top-0 left-0 h-screen w-20 flex flex-col py-4 bg-white border-r border-slate-200 z-50\">\n      {/* Brand logo */}\n      <div className=\"flex flex-col items-center gap-6 mb-8 mt-2\">\n        <div className=\"w-10 h-10 flex items-center justify-center bg-amber-500 rounded-xl text-white shadow-sm hover:scale-105 transition-transform cursor-pointer\">\n          <svg className=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M12 2L22 8V16L12 22L2 16V8L12 2ZM12 4.3L4 9.1V14.9L12 19.7L20 14.9V9.1L12 4.3Z\"></path>\n          </svg>\n        </div>\n      </div>\n\n      {/* Nav Items */}\n      <nav className=\"flex-1 flex flex-col items-center gap-3 w-full px-2 overflow-y-auto scrollbar-hide\">\n        {menuItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = item.id === \'monitoring\'; // We keep \'monitoring\' highlighted as shown in original image\n\n          return (\n            <button\n              key={item.id}\n              onClick={() => {\n                // If they click on settings or dashboard we can show a simulated transition\n              }}\n              className={`w-12 h-12 rounded-xl flex items-center justify-center transition-all duration-200 relative group ${\n                isActive \n                  ? \'bg-amber-400 text-slate-900 shadow-sm\' \n                  : \'text-slate-400 hover:text-slate-700 hover:bg-slate-50\'\n              }`}\n              title={item.label}\n              id={`sidebar-btn-${item.id}`}\n            >\n              <Icon className=\"w-5 h-5 stroke-[2]\" />\n              \n              {/* Tooltip */}\n              <div className=\"absolute left-16 px-2 py-1 bg-slate-800 text-white text-[10px] font-medium rounded opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 whitespace-nowrap z-50 shadow\">\n                {item.label}\n              </div>\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* Settings at the bottom */}\n      <div className=\"mt-auto flex flex-col items-center gap-4 pt-4 border-t border-slate-100\">\n        <button\n          className=\"w-12 h-12 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-50 transition-all duration-200 group relative\"\n          title=\"Configuraci\303\263n\"\n          id=\"sidebar-btn-settings\"\n        >\n          <Settings className=\"w-5 h-5 stroke-[2]\" />\n          <div className=\"absolute left-16 px-2 py-1 bg-slate-800 text-white text-[10px] font-medium rounded opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 whitespace-nowrap z-50 shadow\">\n            Configuraci\303\263n\n          </div>\n        </button>\n      </div>\n    </aside>\n  );\n}\n"
    }
